{
  "name": "koto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "mcp": "tsx src/mcp-server.ts",
    "import": "tsx src/import/run-import.ts",
    "review": "tsx src/review-cli.ts",
    "test": "tsx tests/helpers/setup-db.ts && DATABASE_URL=postgres://koto:koto@localhost:5432/koto_test EMBEDDING_PROVIDER=none node --import tsx --test --test-concurrency=1 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
