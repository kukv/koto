{
  "name": "koto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm run build && pnpm -r run typecheck:tests",
    "mcp": "pnpm --filter @kukv/koto-mcp start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "vitest": "^4.1.11"
  }
}
